+	bool collect_graphics_library_flags(PipelineWorkItem &work_item)
+	{
+		const auto *info = work_item.create_info.graphics_create_info;
+		if (!info)
+			return true;
+		const auto *own = find_pnext<VkGraphicsPipelineLibraryCreateInfoEXT>(
+				VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_LIBRARY_CREATE_INFO_EXT, info->pNext);
+		const auto *linked = find_pnext<VkPipelineLibraryCreateInfoKHR>(
+				VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR, info->pNext);
+		auto &flags = work_item.graphics_library_flags;
+		flags = own ? own->flags : 0;
+		if (!linked)
+			return true;
+
+		// Each graphics state subset may come from only one source (VUID 06611).
+		lock_guard<mutex> lock(internal_enqueue_mutex);
+		for (uint32_t i = 0; i < linked->libraryCount; i++)
+		{
+			auto itr = graphics_library_flags.find(linked->pLibraries[i]);
+			if (itr == end(graphics_library_flags))
+				continue;
+			if (flags & itr->second)
+			{
+				LOGW("Graphics pipeline %016" PRIx64 " links overlapping library subsets, skipping.\n", work_item.hash);
+				return false;
+			}
+			flags |= itr->second;
+		}
+		return true;
+	}
