+static bool test_reused_graphics_library_handle(bool binary)
+{
+	StateRecorder recorder;
+	auto library_handle = fake_handle<VkPipeline>(1);
+	auto linked_handle = fake_handle<VkPipeline>(2);
+	VkGraphicsPipelineLibraryCreateInfoEXT subset = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_LIBRARY_CREATE_INFO_EXT };
+	subset.flags = VK_GRAPHICS_PIPELINE_LIBRARY_VERTEX_INPUT_INTERFACE_BIT_EXT;
+	VkGraphicsPipelineCreateInfo library = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO, &subset };
+	library.flags = VK_PIPELINE_CREATE_LIBRARY_BIT_KHR;
+	Hash library_hash, linked_hash;
+	if (!recorder.record_graphics_pipeline(library_handle, library, nullptr, 0) ||
+	    !recorder.get_hash_for_graphics_pipeline_handle(library_handle, &library_hash))
+		return false;
+
+	// Binding an existing pipeline must not discard the recorded handle.
+	Hash used_hash;
+	if (!recorder.record_pipeline_use(library_handle, VK_PIPELINE_BIND_POINT_GRAPHICS) ||
+	    !recorder.get_hash_for_graphics_pipeline_handle(library_handle, &used_hash) ||
+	    used_hash != library_hash)
+		return false;
+
+	VkPipelineLibraryCreateInfoKHR links = { VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR };
+	links.libraryCount = 1;
+	links.pLibraries = &library_handle;
+	VkGraphicsPipelineCreateInfo linked = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO, &links };
+	if (!Hashing::compute_hash_graphics_pipeline(recorder, linked, &linked_hash))
+		return false;
+
+	// Next, the same handle is recycled for a shader library that cannot be captured.
+	uint8_t id = 0;
+	VkPipelineShaderStageModuleIdentifierCreateInfoEXT identifier = {
+		VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_MODULE_IDENTIFIER_CREATE_INFO_EXT
+	};
+	identifier.identifierSize = 1;
+	identifier.pIdentifier = &id;
+	VkPipelineShaderStageCreateInfo stage = { VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, &identifier };
+	stage.stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+	stage.pName = "main";
+	subset.flags = VK_GRAPHICS_PIPELINE_LIBRARY_FRAGMENT_SHADER_BIT_EXT;
+	library.stageCount = 1;
+	library.pStages = &stage;
+	VkPipelineBinaryInfoKHR binary_info = { VK_STRUCTURE_TYPE_PIPELINE_BINARY_INFO_KHR, &subset };
+	auto binary_handle = fake_handle<VkPipelineBinaryKHR>(1);
+	binary_info.binaryCount = 1;
+	binary_info.pPipelineBinaries = &binary_handle;
+	if (binary)
+		library.pNext = &binary_info;
+	if (!recorder.record_graphics_pipeline(library_handle, library, nullptr, 0) ||
+	    !recorder.record_graphics_pipeline(linked_handle, linked, nullptr, 0))
+		return false;
+
+	// Reusing the handle must invalidate the previous library and the dependent link.
+	return !recorder.get_hash_for_graphics_pipeline_handle(library_handle, &library_hash) &&
+	       !recorder.get_hash_for_graphics_pipeline_handle(linked_handle, &linked_hash);
+}
